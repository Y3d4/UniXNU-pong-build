diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 4de9052..522380c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -856,6 +856,21 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(XNU_PONG_EARLY_TRACE) && XNU_PONG_EARLY_TRACE
+	// MMU is enabled. Use the already-installed KVA mapping for the PA.
+	movz	x9, #0x8540, lsl #16
+	add	x9, x9, x22
+	sub	x9, x9, x23
+	movz	w10, #0x4f50
+	movk	w10, #0x474e, lsl #16
+	str	w10, [x9, #12]
+	movz	w10, #0x4d4d
+	movk	w10, #0x3155, lsl #16
+	str	w10, [x9, #16]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 #if !VMAPPLE
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -920,6 +935,18 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(XNU_PONG_EARLY_TRACE) && XNU_PONG_EARLY_TRACE
+	// Return marker: common_start completed and arm_init() is next.
+	movz	x9, #0x8540, lsl #16
+	add	x9, x9, x22
+	sub	x9, x9, x23
+	movz	w10, #0x4552
+	movk	w10, #0x3154, lsl #16
+	str	w10, [x9, #16]
+	dc	cvac, x9
+	dsb	sy
+#endif
+
 	// Return to arm_init()
 	ret
 
