 #endif
 
+#if defined(XNU_PONG_EARLY_TRACE) && XNU_PONG_EARLY_TRACE
+	// Return marker: common_start completed and arm_init() is next.
+	movz	x9, #0x8540, lsl #16
+	add	x9, x9, x22
+	sub	x9, x9, x23
+	movz	w10, #0x4552
+	movk	w10, #0x3154, lsl #16
+	str	w10, [x9, #16]
