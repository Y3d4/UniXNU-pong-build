@@ -220,6 +220,46 @@
 	.align	3
 	.globl EXT(_start)
 LEXT(_start)
-	b	EXT(start_first_cpu)
+#if defined(XNU_PONG_ENTRY_RESET) && XNU_PONG_ENTRY_RESET
+	// Diagnostic-only mode: prove that DarwinBoot reached the XNU entry.
+	// The pmsg half of the board's ramoops reservation is physically mapped
+	// before MMU setup. Write a Linux-compatible persistent record before the
+	// PSCI reset, so Android can distinguish entry from bootloader fallback.
+	movz	x9, #0x8540, lsl #16
+	movz	w11, #15
+	movz	w10, #0x4f50
+	movk	w10, #0x474e, lsl #16
+	str	w10, [x9, #12]
+	movz	w10, #0x5820
+	movk	w10, #0x554e, lsl #16
+	str	w10, [x9, #16]
+	movz	w10, #0x4520
+	movk	w10, #0x544e, lsl #16
+	str	w10, [x9, #20]
+	movz	w10, #0x5952
+	movk	w10, #0x000a, lsl #16
+	str	w10, [x9, #24]
+	dc	cvac, x9
+	dsb	sy
+	movz	w10, #0x4244
+	movk	w10, #0x4347, lsl #16
+	str	w10, [x9, #0]
+	str	wzr, [x9, #4]
+	str	w11, [x9, #8]
+	dc	cvac, x9
+	dsb	sy
+	// PSCI SYSTEM_RESET precedes start_first_cpu and MMU setup.
+	movz	w0, #0x0009
+	movk	w0, #0x8400, lsl #16
+	mov	x1, xzr
+	mov	x2, xzr
+	mov	x3, xzr
+	smc	#0
+1:
+	wfe
+	b	1b
+#else
+	b	EXT(start_first_cpu)
+#endif
 
 
 /*
@@ -856,6 +856,21 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(XNU_PONG_EARLY_TRACE) && XNU_PONG_EARLY_TRACE
+	// MMU is enabled. Use the already-installed KVA mapping for the PA.
+	movz	x9, #0x8540, lsl #16
+	add	x9, x9, x22
+	sub	x9, x9, x23
+	movz	w10, #0x4f50
+	movk	w10, #0x474e, lsl #16
+	str	w10, [x9, #12]
+	movz	w10, #0x4d4d
+	movk	w10, #0x3155, lsl #16
+	str	w10, [x9, #16]
