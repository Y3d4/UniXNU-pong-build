diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -785,6 +785,45 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(XNU_PONG_ENTRY_STAGE) && XNU_PONG_ENTRY_STAGE
+	// Diagnostic-only checkpoint after common_start has enabled the MMU.
+	// Preserve a compact pmsg record, then reset so Android can read it.
+	movz	x9, #0x8540, lsl #16
+	add	x9, x9, x22
+	sub	x9, x9, x23
+	movz	w10, #0x4f50
+	movk	w10, #0x474e, lsl #16
+	str	w10, [x9, #12]
+	movz	w10, #0x5820
+	movk	w10, #0x554e, lsl #16
+	str	w10, [x9, #16]
+	movz	w10, #0x4d20
+	movk	w10, #0x554d, lsl #16
+	str	w10, [x9, #20]
+	movz	w10, #0x000a
+	str	w10, [x9, #24]
+	dc	cvac, x9
+	dsb	sy
+	movz	w10, #0x4244
+	movk	w10, #0x4347, lsl #16
+	str	w10, [x9, #0]
+	str	wzr, [x9, #4]
+	movz	w10, #13
+	str	w10, [x9, #8]
+	dc	cvac, x9
+	dsb	sy
+	// PSCI SYSTEM_RESET here means XNU passed the initial MMU transition.
+	movz	w0, #0x0009
+	movk	w0, #0x8400, lsl #16
+	mov	x1, xzr
+	mov	x2, xzr
+	mov	x3, xzr
+	smc	#0
+1:
+	wfe
+	b	1b
+#endif
+
 #if defined(XNU_PONG_EARLY_TRACE) && XNU_PONG_EARLY_TRACE
 	// MMU is enabled. Use the already-installed KVA mapping for the PA.
 	movz	x9, #0x8540, lsl #16
